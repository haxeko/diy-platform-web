{
  "id": "matter-light-c6",
  "name": "Matter Light",
  "version": "1.0.0",
  "project": "matter-light-c6",
  "summary": "Đèn Matter over Thread cho ESP32-C6 và ESP32-H2. Ghép đôi bằng mã QR, hỗ trợ độ sáng.",
  "releasedAt": "2026-10-31",
  "status": "stable",
  "changelog": ["Bản phát hành đầu tiên", "Hỗ trợ ESP32-H2"],
  "builds": [
    { "chipFamily": "ESP32-C6", "parts": [
      { "offset": "0x0", "file": "bootloader.bin", "label": "bootloader" },
      { "offset": "0x8000", "file": "partition-table.bin", "label": "partition-table" },
      { "offset": "0x10000", "file": "matter-light.bin", "label": "app" } ] },
    { "chipFamily": "ESP32-H2", "parts": [
      { "offset": "0x0", "file": "bootloader-h2.bin", "label": "bootloader" },
      { "offset": "0x8000", "file": "partition-table-h2.bin", "label": "partition-table" },
      { "offset": "0x10000", "file": "matter-light-h2.bin", "label": "app" } ] }
  ],
  "afterFlash": [
    "Mở ứng dụng Nhà (Apple Home), Google Home hoặc Home Assistant và chọn Thêm phụ kiện.",
    "Quét mã QR Matter in trên hướng dẫn dự án hoặc nhập mã ghép đôi 11 số.",
    "Chờ thiết bị tham gia mạng Thread (đèn nhấp nháy xanh rồi sáng ổn định)."
  ],
  "tags": ["matter", "thread"],
  "demo": true
}
